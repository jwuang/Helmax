---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
import { copy, htmlLanguages, locales, pathFor, type Locale } from '../lib/i18n';
import { production } from '../lib/content';
interface Props {
  locale: Locale; title: string; description: string; section?: string;
  languageLinks?: Partial<Record<Locale, string>>; alternates?: Partial<Record<Locale, string>>; noindex?: boolean;
}
const { locale, title, description, section = '', noindex = false } = Astro.props;
const defaults = Object.fromEntries(locales.map((target) => [target, pathFor(target, section)]));
const languageLinks = Astro.props.languageLinks || defaults;
const alternates = Astro.props.alternates || defaults;
const site = Astro.site || new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).href;
const t = copy[locale];
---
<!doctype html>
<html lang={htmlLanguages[locale]}>
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="color-scheme" content="light"/><meta name="theme-color" content="#142d35"/>
    <title>{title} · {siteConfig.brand[locale].name}</title><meta name="description" content={description}/>
    <meta name="robots" content={!production || noindex ? 'noindex, nofollow' : 'index, follow'}/>
    <link rel="canonical" href={canonical}/>
    {!noindex && locales.map((target) => alternates[target] && <link rel="alternate" hreflang={htmlLanguages[target]} href={new URL(alternates[target]!, site).href}/>)}
    {!noindex && alternates['zh-cn'] && <link rel="alternate" hreflang="x-default" href={new URL(alternates['zh-cn'], site).href}/>}
    <meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
    <meta property="og:locale" content={htmlLanguages[locale].replace('-', '_')}/><meta property="og:image" content={new URL('/images/social-card.png', site).href}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    {!production && <div class="preview-banner">{t.preview}</div>}
    <Header locale={locale} section={section} languageLinks={languageLinks}/>
    <main id="main" tabindex="-1"><slot/></main>
    <Footer locale={locale}/>
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
