---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { copy, locales, pathFor, type Locale } from '../../lib/i18n';
import { siteConfig } from '../../config/site';
import { safeHref } from '../../lib/security';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = copy[locale];
const hasContact = siteConfig.email || siteConfig.phone || siteConfig.address[locale] || siteConfig.wechatQr;
---
<BaseLayout locale={locale} title={t.contact} description={t.contactDescription} section="contact">
  <div class="container"><nav class="breadcrumb" aria-label={t.breadcrumb}><a href={pathFor(locale)}>{t.home}</a><span aria-hidden="true">/</span><span>{t.contact}</span></nav><div class="contact-layout"><div class="page-heading"><p class="eyebrow">{t.contact}</p><h1 class="preserve-lines">{t.contactTitle}</h1><p>{t.contactDescription}</p></div><div class="contact-panel">
    {!hasContact && <p class="notice">{t.contactPending}</p>}
    {siteConfig.email && <div class="contact-row"><h2>{t.email}</h2><a href={safeHref(`mailto:${siteConfig.email}`)}>{siteConfig.email}<Arrow diagonal/></a></div>}
    {siteConfig.phone && <div class="contact-row"><h2>{t.phone}</h2><a href={safeHref(`tel:${siteConfig.phone.replace(/[ ()-]/g, '')}`)}>{siteConfig.phone}<Arrow diagonal/></a></div>}
    {siteConfig.address[locale] && <div class="contact-row"><h2>{t.address}</h2><p>{siteConfig.address[locale]}</p></div>}
    {siteConfig.wechatQr && <div class="contact-row"><h2>{t.wechat}</h2><img src={siteConfig.wechatQr} alt={t.qrAlt} width="160" height="160" loading="lazy"/></div>}
  </div></div></div>
</BaseLayout>
