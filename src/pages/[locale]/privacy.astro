---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, locales, pathFor, type Locale } from '../../lib/i18n';
import { siteConfig } from '../../config/site';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = copy[locale];
---
<BaseLayout locale={locale} title={t.privacy} description={t.privacyLead} section="privacy">
  <div class="container"><div class="page-heading"><p class="eyebrow">{t.privacy}</p><h1>{t.privacyTitle}</h1><p>{t.privacyLead}</p></div><div class="prose privacy-body">
    <p class="article-meta">{t.updated} <time datetime={siteConfig.privacyUpdated}>{siteConfig.privacyUpdated}</time></p>
    {!siteConfig.privacyReviewed && <p class="notice">{t.privacyPending}</p>}
    {t.privacySections.map((section) => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}
    <a href={pathFor(locale, 'contact')}>{t.contact}</a>
  </div></div>
</BaseLayout>
