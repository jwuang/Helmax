---
import { Picture } from 'astro:assets';
import architecture from '../../assets/architecture.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ContentCard from '../../components/ContentCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { copy, locales, pathFor, type Locale } from '../../lib/i18n';
import { entries } from '../../lib/content';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = copy[locale];
const services = await entries('services', locale);
---
<BaseLayout locale={locale} title={t.heroLine1 + ' ' + t.heroLine2} description={t.heroDescription}>
  <section class="hero container">
    <p class="eyebrow">{t.eyebrow}</p>
    <div class="hero-heading"><h1>{t.heroLine1}<br/><span>{t.heroLine2}</span></h1><div class="hero-intro"><p>{t.heroDescription}</p><a class="button" href={pathFor(locale, services.length ? 'services' : 'contact')}>{services.length ? t.explore : t.talk}<Arrow diagonal/></a></div></div>
    <div class="hero-image"><Picture src={architecture} widths={[480, 768, 1200, 1600]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1100px) calc(100vw - 64px), (max-width: 1392px) calc(100vw - 112px), 1280px" formats={['avif', 'webp']} alt={t.artAlt} loading="eager" fetchpriority="high"/><span class="hero-image-caption" aria-hidden="true">A SHARED VISION. A WAY FORWARD.</span></div>
    <div class="hero-bottom"><span>IDEAS INTO POSSIBILITIES</span><a href="#perspective">{t.scroll}<Arrow/></a></div>
  </section>
  <section id="perspective" class="section container intro-grid"><div><p class="eyebrow">{t.introLabel}</p><h2 class="preserve-lines">{t.introTitle}</h2></div><div class="intro-copy"><p>{t.introDescription}</p><a class="text-link" href={pathFor(locale, 'about')}>{t.aboutLink}<Arrow diagonal/></a></div></section>
  {services.length > 0 && <section class="section services-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t.servicesLabel}</p><h2>{t.servicesTitle}</h2></div><a class="text-link" href={pathFor(locale, 'services')}>{t.allServices}<Arrow diagonal/></a></div><div class="card-grid">{services.slice(0, 3).map((entry, index) => <ContentCard entry={entry} index={index}/>)}</div></div></section>}
  <section class="section container approach-grid"><div><p class="eyebrow">{t.approachLabel}</p><h2 class="preserve-lines">{t.approachTitle}</h2></div><div class="steps">{t.steps.map((step, i) => <div class="step"><span>{String(i + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></div>)}</div></section>
  <ContactCTA locale={locale}/>
</BaseLayout>
