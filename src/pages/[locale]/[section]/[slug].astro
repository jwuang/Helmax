---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Arrow from '../../../components/Arrow.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import { copy, locales, pathFor } from '../../../lib/i18n';
import { entries, entryPath, type Entry } from '../../../lib/content';
import { sections } from '../../../lib/content-model';
export async function getStaticPaths() {
  const all = (await Promise.all(sections.map((section) => entries(section)))).flat();
  return all.map((entry) => ({ params: { locale: entry.data.locale, section: entry.collection, slug: entry.data.routeSlug }, props: { entry } }));
}
interface Props { entry: Entry; }
const { entry } = Astro.props;
const { locale } = entry.data;
const section = entry.collection;
const t = copy[locale];
const { Content } = await render(entry);
const siblings = await entries(section);
const translated = siblings.filter((item) => item.data.translationKey === entry.data.translationKey);
const alternates = Object.fromEntries(translated.map((item) => [item.data.locale, entryPath(item)]));
const languageLinks = Object.fromEntries(locales.map((target) => [target, alternates[target] || `${pathFor(target, section)}#translation-unavailable`]));
const related = siblings.filter((item) => item.data.locale === locale && item.id !== entry.id).slice(0, 3);
const date = entry.data.updatedAt || entry.data.publishedAt;
---
<BaseLayout locale={locale} title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDescription || entry.data.summary} section={section} languageLinks={languageLinks} alternates={alternates}>
  <div class="container"><nav class="breadcrumb" aria-label={t.breadcrumb}><a href={pathFor(locale)}>{t.home}</a><span aria-hidden="true">/</span><a href={pathFor(locale, section)}>{t[section]}</a><span aria-hidden="true">/</span><span>{entry.data.title}</span></nav><div class="page-heading"><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p>{entry.data.summary}</p></div><div class="article-layout"><article>
    {entry.data.previewOnly && <p class="notice">{t.previewDetail}</p>}
    <p class="article-meta">{t.updated} <time datetime={date.toISOString()}>{new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(date)}</time></p>
    {entry.data.cover && <img class="article-cover" src={entry.data.cover} alt={entry.data.coverAlt} width="1200" height="675" loading="eager"/>}
    <div class="prose"><Content/></div><a class="text-link" href={pathFor(locale, section)}>{t.back}<Arrow/></a>
  </article><aside class="article-aside"><h2>{t.related}</h2>{related.map((item) => <a href={entryPath(item)}>{item.data.title}<Arrow diagonal/></a>)}<a href={pathFor(locale, 'contact')}>{t.contact}<Arrow diagonal/></a></aside></div></div>
  <ContactCTA locale={locale}/>
</BaseLayout>
