---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import { copy, locales, pathFor, type Locale } from '../../../lib/i18n';
import { entries } from '../../../lib/content';
import { sections, type Section } from '../../../lib/content-model';
export function getStaticPaths() { return locales.flatMap((locale) => sections.map((section) => ({ params: { locale, section } }))); }
const locale = Astro.params.locale as Locale;
const section = Astro.params.section as Section;
const t = copy[locale];
const items = await entries(section, locale);
const available = await Promise.all(locales.map(async (target) => ({ target, count: (await entries(section, target)).length })));
const alternates = Object.fromEntries(available.filter(({ count }) => count > 0).map(({ target }) => [target, pathFor(target, section)]));
const description = section === 'services' ? t.servicesDescription : section === 'cases' ? t.caseDescription : t.newsDescription;
---
<BaseLayout locale={locale} title={t[section]} description={description} section={section} noindex={items.length === 0} alternates={alternates}>
  <div class="container"><nav class="breadcrumb" aria-label={t.breadcrumb}><a href={pathFor(locale)}>{t.home}</a><span aria-hidden="true">/</span><span>{t[section]}</span></nav><div class="page-heading"><p class="eyebrow">{t[section]}</p><h1>{section === 'services' ? t.servicesTitle : t[section]}</h1><p>{description}</p></div><p id="translation-unavailable" class="notice fallback-notice">{t.fallback}</p><div class="page-list">{items.length ? <div class="card-grid">{items.map((entry, index) => <ContentCard entry={entry} index={index}/>)}</div> : <p class="empty">{t.empty}</p>}</div></div>
  <ContactCTA locale={locale}/>
</BaseLayout>
