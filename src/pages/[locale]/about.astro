---
import { Picture } from 'astro:assets';
import architecture from '../../assets/architecture.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { copy, locales, pathFor, type Locale } from '../../lib/i18n';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = copy[locale];
---
<BaseLayout locale={locale} title={t.about} description={t.aboutDescription} section="about">
  <div class="container"><nav class="breadcrumb" aria-label={t.breadcrumb}><a href={pathFor(locale)}>{t.home}</a><span aria-hidden="true">/</span><span>{t.about}</span></nav><div class="page-heading"><p class="eyebrow">{t.about}</p><h1>{t.aboutTitle}</h1><p>{t.aboutDescription}</p></div><div class="about-art"><Picture src={architecture} widths={[480, 768, 1200, 1600]} sizes="(max-width: 767px) 100vw, 90vw" formats={['avif', 'webp']} alt={t.artAlt} loading="eager"/></div></div>
  <section class="section container"><div class="intro-grid"><h2>{t.valuesTitle}</h2><p class="prose">{t.aboutBody}</p></div><div class="values-grid">{t.values.map((value, i) => <div class="value"><span>0{i + 1}</span><h3>{value.title}</h3><p>{value.description}</p></div>)}</div></section>
  <ContactCTA locale={locale}/>
</BaseLayout>
