---
import Arrow from './Arrow.astro';
import { copy, pathFor, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<section class="cta-section">
  <div class="container cta-inner"><div><p class="eyebrow">{t.ctaLabel}</p><h2 class="preserve-lines">{t.ctaTitle}</h2><p>{t.ctaDescription}</p></div><a class="cta-circle" href={pathFor(locale, 'contact')}><Arrow diagonal/><span>{t.talk}</span></a></div>
</section>
