---
import Brand from './Brand.astro';
import Arrow from './Arrow.astro';
import { copy, locales, languageNames, htmlLanguages, pathFor, type Locale } from '../lib/i18n';
import { availableSections } from '../lib/content';
interface Props { locale: Locale; section?: string; languageLinks: Partial<Record<Locale, string>>; }
const { locale, section = '', languageLinks } = Astro.props;
const t = copy[locale];
const available = await availableSections(locale);
const links = [{ key: '', label: t.home }, { key: 'about', label: t.about }, ...available.map((key) => ({ key, label: t[key] }))];
---
<header class="site-header">
  <div class="container header-inner">
    <Brand locale={locale} />
    <nav class="desktop-nav" aria-label={t.navigation}>
      {links.map((link) => <a href={pathFor(locale, link.key)} aria-current={section === link.key ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <details class="language-menu" data-language-menu>
        <summary aria-label={t.language}><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg><span>{locale === 'en' ? 'EN' : locale === 'zh-hk' ? '繁' : '简'}</span><span aria-hidden="true">⌄</span></summary>
        <div class="language-options">
          {locales.map((target) => <a href={languageLinks[target] || pathFor(target)} lang={htmlLanguages[target]} hreflang={htmlLanguages[target]} aria-current={target === locale ? 'true' : undefined}>{languageNames[target]}<span aria-hidden="true">{target === locale ? '✓' : '↗'}</span></a>)}
        </div>
      </details>
      <a class="button button-small header-contact" href={pathFor(locale, 'contact')}>{t.contact}<Arrow diagonal /></a>
      <details class="mobile-menu" data-mobile-menu>
        <summary aria-label={t.menu}><span class="hamburger" aria-hidden="true"></span><span class="sr-only">{t.menu}</span></summary>
        <nav class="mobile-panel" aria-label={t.menu}>
          {[...links, { key: 'contact', label: t.contact }].map((link) => <a href={pathFor(locale, link.key)} aria-current={section === link.key ? 'page' : undefined}>{link.label}<Arrow /></a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
