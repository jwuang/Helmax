{
  "name": "Corporate Portal · Node 26",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26-bookworm",
  "forwardPorts": [
    4321
  ],
  "portsAttributes": {
    "4321": {
      "label": "Helmax website",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install --global pnpm@12.16.1 && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
