{
  "name": "corporate-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check && node --import tsx scripts/validate-content.ts",
    "lint": "eslint .",
    "build": "node --import tsx scripts/build.ts",
    "build:preview": "node --import tsx scripts/build.ts --preview",
    "build:pages": "node --import tsx scripts/build-pages.ts",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:pages": "node scripts/check-design-prototype.mjs --built",
    "test:e2e": "playwright test",
    "test:headers": "node --import tsx scripts/check-headers.ts",
    "test:load": "node --import tsx scripts/load-test.ts",
    "audit:security": "pnpm audit --audit-level high",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build:preview && pnpm test:e2e",
    "prepare:art": "node scripts/prepare-art.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "astro": "7.4.4",
    "cheerio": "1.2.0",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "gray-matter": "4.0.3",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
