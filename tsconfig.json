{
  "include": [
    "cloudflare.config.ts",
    "wrangler.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "dist-pages",
    "node_modules",
    "playwright-report",
    "test-results",
    "reports",
    "artifacts"
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true
  }
}
